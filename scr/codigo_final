import matplotlib.patches as patches

def plotar_deteccoes_ortomosaico(raster_src, df_predicoes, raio_m=2.0, max_display_dim=3000, salvar_imagem=True):
    """
    Renderiza o ortomosaico com caixas delimitadoras (bounding boxes) nas coordenadas das árvores identificadas.
    Aplica downsampling para evitar sobrecarga de memória (RAM) no Colab.
    """
    print("\n--- Gerando visualização das árvores no Ortomosaico ---")

    # Fator de escala/downsampling para plotagem rápida no Colab
    scale_factor = max(1, max(raster_src.width, raster_src.height) // max_display_dim)
    out_shape = (
        min(3, raster_src.count),
        int(raster_src.height // scale_factor),
        int(raster_src.width // scale_factor)
    )

    # Leitura das bandas RGB com redução de resolução
    rgb_image = raster_src.read(
        indexes=(1, 2, 3) if raster_src.count >= 3 else [1]*3,
        out_shape=out_shape,
        resampling=rasterio.enums.Resampling.bilinear
    ).astype('float32')

    # Normalização dos canais para escala [0, 1] com percentis
    rgb_normalized = np.zeros((rgb_image.shape[1], rgb_image.shape[2], 3), dtype='float32')
    for i in range(3):
        b = rgb_image[i]
        p2, p98 = np.nanpercentile(b, (2, 98))
        if p98 > p2:
            rgb_normalized[:, :, i] = np.clip((b - p2) / (p98 - p2), 0, 1)
        else:
            rgb_normalized[:, :, i] = b / 255.0

    extent = [raster_src.bounds.left, raster_src.bounds.right, raster_src.bounds.bottom, raster_src.bounds.top]

    fig, ax = plt.subplots(figsize=(16, 16), dpi=150)
    ax.imshow(rgb_normalized, extent=extent)

    # Conversão de coordenadas para o CRS do raster
    if df_predicoes.crs != raster_src.crs:
        df_geo = df_predicoes.to_crs(raster_src.crs)
    else:
        df_geo = df_predicoes

    # Atribui uma cor consistente para cada espécie predita
    especies_unicas = df_geo['especie_predita'].unique()
    paleta = sns.color_palette('hsv', len(especies_unicas))
    color_map = dict(zip(especies_unicas, paleta))

    # Dimensão do retângulo (largura e altura = 2 * raio)
    box_size = raio_m * 2.0

    for _, row in df_geo.iterrows():
        cx, cy = row.geometry.x, row.geometry.y
        x_min = cx - raio_m
        y_min = cy - raio_m
        cor = color_map.get(row['especie_predita'], 'yellow')

        # Desenha a caixa delimitadora da copa
        rect = patches.Rectangle(
            (x_min, y_min),
            box_size,
            box_size,
            linewidth=1.2,
            edgecolor=cor,
            facecolor='none',
            linestyle='-'
        )
        ax.add_patch(rect)

    # Legenda customizada com as espécies
    legend_handles = [
        patches.Patch(edgecolor=color_map[esp], facecolor='none', linewidth=1.5, label=esp)
        for esp in especies_unicas
    ]
    ax.legend(
        handles=legend_handles,
        loc='upper right',
        bbox_to_anchor=(1.25, 1.0),
        title='Espécies Identificadas',
        frameon=True
    )

    ax.set_title(f'Árvores Identificadas no Ortomosaico (Total: {len(df_geo)})', fontsize=14, pad=12)
    ax.set_xlabel('UTM X (m)')
    ax.set_ylabel('UTM Y (m)')
    ax.grid(color='white', alpha=0.2, linestyle=':')

    if salvar_imagem:
        caminho_img = f'{OUTPUT_DIR}/visualizacao_ortomosaico_deteccoes.png'
        plt.savefig(caminho_img, bbox_inches='tight', dpi=300)
        print(f"Mapa visual salvo em: {caminho_img}")

    plt.show()

