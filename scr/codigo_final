"""### 7. Classificação em Larga Escala (Mapeamento Total)
Este passo aplica o modelo treinado em toda a extensão do arquivo GeoTIFF, gerando um mapa de predição de espécies para a área completa.
"""

import numpy as np
import rasterio
from rasterio.windows import Window
import joblib
import os
import pandas as pd

def mapear_area_total(raster_path, model_bundle_path, output_map_path, step_size=20):
    print(f"--- Iniciando Mapeamento Total: {os.path.basename(raster_path)} ---")

    # Carrega o modelo e os metadados
    bundle = joblib.load(model_bundle_path)
    model = bundle['model']
    feature_names = bundle['feature_names']
    raio_m = bundle['radius_m']

    with rasterio.open(raster_path) as src:
        profile = src.profile
        res = src.res[0]
        # O raio em pixels para a janela deslizante
        win_size = int(np.ceil(raio_m / res)) * 2 + 1

        # Prepara o perfil de saída (1 banda com os IDs das classes)
        profile.update(count=1, dtype=rasterio.uint8, nodata=0)

        with rasterio.open(output_map_path, 'w', **profile) as dst:
            # Processamento por blocos para evitar estouro de memória
            # Aumentamos o step_size para 20 para agilizar o processamento da área total
            for y in range(0, src.height - step_size, step_size):
                for x in range(0, src.width - step_size, step_size):
                    # Coordenada central da célula atual
                    real_x, real_y = src.xy(y + step_size//2, x + step_size//2)

                    try:
                        # Extrai atributos do raster (a mesma função usada no treino)
                        feat = extract_features(src, real_x, real_y, raio_m)

                        # Preenche atributos de patch/CNN com 0 para a inferência de área total
                        # (Já que não temos fotos de campo para cada pixel do mapa)
                        for col in feature_names:
                            if col not in feat: feat[col] = 0

                        # Organiza os dados e realiza a predição
                        df_input = pd.DataFrame([feat])[feature_names]
                        pred_class = model.predict(df_input)[0]

                        # Escreve o ID da espécie no bloco correspondente (+1 para evitar conflito com 0/NoData)
                        chunk = np.full((step_size, step_size), int(pred_class) + 1, dtype=rasterio.uint8)
                        dst.write(chunk, 1, window=Window(x, y, step_size, step_size))

                    except Exception:
                        continue

                if y % 1000 == 0:
                    progresso = (y / src.height) * 100
                    print(f"Progresso: {progresso:.1f}%")

    print(f"✅ Mapa exportado com sucesso para: {output_map_path}")

# Caminho para salvar o mapa e execução
map_output = os.path.join(OUTPUT_DIR, 'mapa_especies_final.tif')
mapear_area_total(RASTER_PATH, os.path.join(OUTPUT_DIR, 'modelo_especies_arvores.joblib'), map_output)

