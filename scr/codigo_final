    for _, rec in ngdf.iterrows():
        id_arv = str(rec['Ind.'])
        esp_dummy = str(rec['Nome Científico']) if 'Nome Científico' in rec.index and pd.notna(rec['Nome Científico']) else ''

        # 1. Atributos do Raster
        feat = extract_features(raster, rec.geometry.x, rec.geometry.y, bundle['radius_m'])

        # 2. Estatísticas RGB do Patch
        patch_rgb_feat = extract_patch_rgb_stats(PATCHES_DIR, esp_dummy, id_arv)
        feat.update(patch_rgb_feat)

        # 3. Embedding Bruto do Patch
        patch_emb = extract_patch_raw_embedding(PATCHES_DIR, esp_dummy, id_arv)
        raw_patch_embeddings_new.append(patch_emb)

        for c in ['DAP', 'HT', 'HC', 'Área Basal - G']:
            feat[c] = rec[c] if c in rec.index else np.nan

        rows.append(feat)

    # Processa PCA se disponível
    pca_cols = [f'patch_pca_{i}' for i in range(N_PCA_PATCH_COMPONENTS)]
    if bundle.get('pca_patch') is not None:
        X_p_raw = np.array(raw_patch_embeddings_new)
        X_p_imp = np.nan_to_num(X_p_raw, nan=0.0)
        X_p_pca = bundle['pca_patch'].transform(X_p_imp)
        df_pca = pd.DataFrame(X_p_pca, columns=pca_cols)
    else:
        df_pca = pd.DataFrame(np.zeros((len(ngdf), N_PCA_PATCH_COMPONENTS)), columns=pca_cols)

    df_raster = pd.DataFrame(rows)
    newX = pd.concat([df_raster, df_pca], axis=1).reindex(columns=bundle['feature_names'])
    newX = newX.apply(pd.to_numeric, errors='coerce')

    pred = bundle['model'].predict(newX)

    new['especie_predita'] = bundle['label_encoder'].inverse_transform(pred)
    if hasattr(bundle['model'], 'predict_proba'):
        new['confianca'] = bundle['model'].predict_proba(newX).max(axis=1)

    result = gpd.GeoDataFrame(
        new,
        geometry=gpd.points_from_xy(new['UTM X'], new['UTM Y']),
        crs=bundle['coordinate_crs']
    )

    caminho_gpkg = f'{OUTPUT_DIR}/{nome_saida}'
    caminho_csv = f'{OUTPUT_DIR}/{nome_saida.replace(".gpkg", ".csv")}'

    result.to_file(caminho_gpkg, driver='GPKG')
    result.drop(columns='geometry').to_csv(caminho_csv, index=False)

    print(f"\n Processamento concluído com sucesso!")
    print(f"📍 Arquivo GeoPackage: {caminho_gpkg}")
    print(f"📊 Arquivo CSV: {caminho_csv}")

    return result

