def extract_patch_raw_embedding(patches_dir, especie, id_arvore):
    patch_path = localizar_arquivo_patch(patches_dir, especie, id_arvore)
    if patch_path is None: return np.full(512, np.nan)
    try:
        img = Image.open(patch_path).convert('RGB')
        tensor_img = transform_cnn(img).unsqueeze(0)
        with torch.no_grad():
            return feature_extractor(tensor_img).flatten().numpy()
    except: return np.full(512, np.nan)

def extract_patch_rgb_stats(patches_dir, especie, id_arvore):
    patch_path = localizar_arquivo_patch(patches_dir, especie, id_arvore)

    rgb_keys = [f'patch_{c}_{s}' for c in ['r','g','b'] for s in ['mean','std','min','max','p10','p50','p90']] + ['patch_exg', 'patch_green_red_ratio', 'patch_green_blue_ratio']
    hsv_keys = [f'patch_{c}_{s}' for c in ['h','s','v'] for s in ['mean','std','p50']]
    glcm_keys = ['patch_glcm_contrast', 'patch_glcm_correlation', 'patch_glcm_energy', 'patch_glcm_homogeneity']
    out_keys = rgb_keys + hsv_keys + glcm_keys

    if patch_path is None: return {k: np.nan for k in out_keys}
    try:
        img = Image.open(patch_path).convert('RGB')
        arr = np.array(img, dtype='float32')
        out, medians = {}, []

        # --- 1. RGB STATS ---
        for idx, ch_name in enumerate(['r', 'g', 'b']):
            vals = arr[:, :, idx].ravel()
            vals = vals[np.isfinite(vals)]
            if len(vals) > 0:
                out[f'patch_{ch_name}_mean'] = np.mean(vals)
                out[f'patch_{ch_name}_std'] = np.std(vals)
                out[f'patch_{ch_name}_min'] = np.min(vals)
                out[f'patch_{ch_name}_max'] = np.max(vals)
                out[f'patch_{ch_name}_p10'] = np.percentile(vals, 10)
                out[f'patch_{ch_name}_p50'] = np.percentile(vals, 50)
                out[f'patch_{ch_name}_p90'] = np.percentile(vals, 90)
                medians.append(np.median(vals))
            else:
                for s in ['mean','std','min','max','p10','p50','p90']: out[f'patch_{ch_name}_{s}'] = np.nan
                medians.append(np.nan)
        r, g, b = medians
        eps = 1e-6
        if np.isfinite(r) and np.isfinite(g) and np.isfinite(b):
            out['patch_exg'] = (2*g - r - b) / (r + g + b + eps)
            out['patch_green_red_ratio'] = g / (r + eps)
            out['patch_green_blue_ratio'] = g / (b + eps)
        else:
            out['patch_exg'] = np.nan
            out['patch_green_red_ratio'] = np.nan
            out['patch_green_blue_ratio'] = np.nan

        # --- 2. HSV STATS ---
        arr_norm = arr / 255.0  # rgb2hsv espera valores em [0, 1]
        hsv_arr = rgb2hsv(arr_norm)
        for idx, ch_name in enumerate(['h', 's', 'v']):
            vals = hsv_arr[:, :, idx].ravel()
            vals = vals[np.isfinite(vals)]
            if len(vals) > 0:
                out[f'patch_{ch_name}_mean'] = np.mean(vals)
                out[f'patch_{ch_name}_std'] = np.std(vals)
                out[f'patch_{ch_name}_p50'] = np.percentile(vals, 50)
            else:
                for s in ['mean','std','p50']: out[f'patch_{ch_name}_{s}'] = np.nan

        # --- 3. GLCM TEXTURE STATS ---
        gray_img = img_as_ubyte(rgb2gray(arr_norm))
        # Computando matriz de coocorrência (distância=1, ângulo=0 horizontal)
        glcm = graycomatrix(gray_img, distances=[1], angles=[0], levels=256, symmetric=True, normed=True)
        out['patch_glcm_contrast'] = graycoprops(glcm, 'contrast')[0, 0]
        out['patch_glcm_correlation'] = graycoprops(glcm, 'correlation')[0, 0]
        out['patch_glcm_energy'] = graycoprops(glcm, 'energy')[0, 0]
        out['patch_glcm_homogeneity'] = graycoprops(glcm, 'homogeneity')[0, 0]

        return out
    except:
        return {k: np.nan for k in out_keys}

