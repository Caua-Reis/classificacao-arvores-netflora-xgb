# SEÇÃO DEDICADA: EXTRAÇÃO EXCLUSIVA DE INFORMAÇÕES RGB DA ORTOFOTO
# ==============================================================================

def extract_rgb_from_orthophoto(src, x, y, radius_m):
    """
    Extrai exclusivamente as estatísticas radiométricas (R, G, B)
    e índices de vegetação visíveis diretamente da ortofoto GeoTIFF.
    """
    pixel_size = max(abs(src.res[0]), abs(src.res[1]))
    radius_px = max(1, int(np.ceil(radius_m / pixel_size)))
    row, col = src.index(x, y)
    win = Window(col - radius_px, row - radius_px, 2 * radius_px + 1, 2 * radius_px + 1).intersection(
        Window(0, 0, src.width, src.height)
    )

    # Lê estritamente as 3 primeiras bandas (Red, Green, Blue)
    arr = src.read(indexes=(1, 2, 3), window=win, masked=True).astype('float32')

    out_keys = [f'ortofoto_{c}_{s}' for c in ['r', 'g', 'b'] for s in ['mean', 'std', 'min', 'max', 'p10', 'p50', 'p90']] + \
               ['ortofoto_exg', 'ortofoto_vari', 'ortofoto_gli', 'ortofoto_ngrdi', 'ortofoto_green_red_ratio', 'ortofoto_green_blue_ratio']

    if arr.size == 0 or arr.shape[0] < 3:
        return {k: np.nan for k in out_keys}

    out = {}
    channel_names = ['r', 'g', 'b']
    medians = []

    for b_idx, c_name in enumerate(channel_names):
        band_vals = arr[b_idx].compressed() if np.ma.isMaskedArray(arr[b_idx]) else arr[b_idx].ravel()
        band_vals = band_vals[np.isfinite(band_vals)]

        if len(band_vals) > 0:
            out[f'ortofoto_{c_name}_mean'] = float(np.mean(band_vals))
            out[f'ortofoto_{c_name}_std'] = float(np.std(band_vals))
            out[f'ortofoto_{c_name}_min'] = float(np.min(band_vals))
            out[f'ortofoto_{c_name}_max'] = float(np.max(band_vals))
            out[f'ortofoto_{c_name}_p10'] = float(np.percentile(band_vals, 10))
            out[f'ortofoto_{c_name}_p50'] = float(np.percentile(band_vals, 50))
            out[f'ortofoto_{c_name}_p90'] = float(np.percentile(band_vals, 90))
            medians.append(float(np.median(band_vals)))
        else:
            for s in ['mean', 'std', 'min', 'max', 'p10', 'p50', 'p90']:
                out[f'ortofoto_{c_name}_{s}'] = np.nan
            medians.append(np.nan)

    # Cálculo dos Índices de Vegetação RGB da Ortofoto
    eps = 1e-6
    r, g, b = medians
    if np.isfinite(r) and np.isfinite(g) and np.isfinite(b):
        out['ortofoto_exg'] = float((2 * g - r - b) / (r + g + b + eps))
        out['ortofoto_vari'] = float((g - r) / (g + r - b + eps))
        out['ortofoto_gli'] = float((2 * g - r - b) / (2 * g + r + b + eps))
        out['ortofoto_ngrdi'] = float((g - r) / (g + r + eps))
        out['ortofoto_green_red_ratio'] = float(g / (r + eps))
        out['ortofoto_green_blue_ratio'] = float(g / (b + eps))
    else:
        out['ortofoto_exg'] = np.nan
        out['ortofoto_vari'] = np.nan
        out['ortofoto_gli'] = np.nan
        out['ortofoto_ngrdi'] = np.nan
        out['ortofoto_green_red_ratio'] = np.nan
        out['ortofoto_green_blue_ratio'] = np.nan

    return out

