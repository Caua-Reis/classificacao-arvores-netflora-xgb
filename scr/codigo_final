def extract_features(src, x, y, radius_m):
    """
    Extrai estatísticas básicas do raster para um dado ponto e raio.
    """
    pixel_size = max(abs(src.res[0]), abs(src.res[1]))
    radius_px = max(1, int(np.ceil(radius_m / pixel_size)))
    row, col = src.index(x, y)

    win = Window(col - radius_px, row - radius_px, 2 * radius_px + 1, 2 * radius_px + 1).intersection(
        Window(0, 0, src.width, src.height)
    )

    arr = src.read(indexes=(1, 2, 3), window=win, masked=True).astype('float32')
    out = {}

    if arr.size == 0 or arr.shape[0] < 3:
        return {f'raster_{c}_{s}': np.nan for c in ['r', 'g', 'b'] for s in ['mean', 'std', 'p50']}

    for b_idx, c_name in enumerate(['r', 'g', 'b']):
        band_vals = arr[b_idx].compressed() if np.ma.isMaskedArray(arr[b_idx]) else arr[b_idx].ravel()
        band_vals = band_vals[np.isfinite(band_vals)]

        if len(band_vals) > 0:
            out[f'raster_{c_name}_mean'] = float(np.mean(band_vals))
            out[f'raster_{c_name}_std'] = float(np.std(band_vals))
            out[f'raster_{c_name}_p50'] = float(np.median(band_vals))
        else:
            out[f'raster_{c_name}_mean'] = np.nan
            out[f'raster_{c_name}_std'] = np.nan
            out[f'raster_{c_name}_p50'] = np.nan

    return out

